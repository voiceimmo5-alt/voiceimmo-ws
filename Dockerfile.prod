# ============================================
# VoiceImmo WS — Image PRODUCTION
# ============================================
FROM node:20-alpine

WORKDIR /app

# Dépendances
COPY package.json .
RUN npm install --omit=dev

# Code serveur
COPY server.js .

# Variables d'env (à surcharger au runtime)
ENV NODE_ENV=production
ENV PORT=8080
ENV OAI_MODEL=gpt-realtime

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD wget -qO- http://localhost:${PORT}/ || exit 1

EXPOSE 8080

CMD ["node", "server.js"]
